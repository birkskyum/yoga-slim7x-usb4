# First checkpoint is not the PCI0 test. No USB4 DT markers or frontend module.
CONFIG_USB4_X1_ADSP_HANDOFF=y
# CONFIG_USB4_X1_EL2_TEST is not set
CONFIG_ARM_SMMU_V3=y
CONFIG_IOMMU_DEFAULT_DMA_STRICT=y
# CONFIG_IOMMU_DEFAULT_PASSTHROUGH is not set
CONFIG_QCOM_TZMEM_MODE_GENERIC=y
# CONFIG_QCOM_TZMEM_MODE_SHMBRIDGE is not set
CONFIG_QCOM_Q6V5_PAS=m
