From e930247ab3821d7b3d71a1ca52c023763d9ea742 Mon Sep 17 00:00:00 2001
From: Birk Skyum <birk.skyum@pm.me>
Date: Wed, 23 Sep 2026 04:34:50 +0200
Subject: [PATCH 07/10] Omarchy flavor: power an idle router down before system
 sleep, and let a fully retired session suspend

---
 drivers/thunderbolt/ctl.c               |  13 +
 drivers/thunderbolt/ctl.h               |   1 +
 drivers/thunderbolt/qcom-usb4-x1-host.c | 378 +++++++++++++++++++++++-
 drivers/thunderbolt/qcom-usb4-x1-pcie.c |  82 +++++
 drivers/thunderbolt/qcom-usb4-x1-pcie.h |   3 +
 drivers/thunderbolt/tb.c                | 152 ++++++++++
 drivers/thunderbolt/tb.h                |   4 +
 7 files changed, 627 insertions(+), 6 deletions(-)

diff --git a/drivers/thunderbolt/ctl.c b/drivers/thunderbolt/ctl.c
index 93236fb..8f4b8f4 100644
--- a/drivers/thunderbolt/ctl.c
+++ b/drivers/thunderbolt/ctl.c
@@ -916,6 +916,19 @@ bool tb_ctl_x1_retired(struct tb_ctl *ctl, struct tb_nhi *nhi)
 {
 	return ctl && ctl->nhi == nhi && smp_load_acquire(&ctl->x1_retired);
 }
+
+/* Omarchy flavor: running with no request in flight, before the checked stop. */
+bool tb_ctl_x1_idle(struct tb_ctl *ctl)
+{
+	bool idle;
+
+	if (!ctl)
+		return false;
+	mutex_lock(&ctl->request_queue_lock);
+	idle = ctl->running && !ctl->x1_stop_attempted && list_empty(&ctl->request_queue);
+	mutex_unlock(&ctl->request_queue_lock);
+	return idle;
+}
 #endif
 
