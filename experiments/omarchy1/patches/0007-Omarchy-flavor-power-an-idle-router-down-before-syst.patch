+static bool tb_x1_root_empty(struct tb *tb)
+{
+	struct tb_port *port;
+
+	if (!tb->root_switch || tb->root_switch->is_unplugged)
+		return false;
+	tb_switch_for_each_port(tb->root_switch, port)
+		if (port->remote || port->xdomain)
+			return false;
+	return true;
+}
+
+/**
+ * tb_x1_idle_freeze() - Freeze an empty X1 domain before an idle power-down
+ * @tb: Native domain of the X1 router-0 frontend, never approved or held
+ *
+ * Omarchy flavor. Caller holds the owner device, frontend and domain locks.
+ * Like a tunnel hold, the retained flag turns later events into records only,
+ * so no CM worker issues control requests while the router is stopped.
+ */
+int tb_x1_idle_freeze(struct tb *tb)
+{
+	struct tb_cm *tcm;
+	int ret;
+
+	if (!tb)
+		return -EINVAL;
+	lockdep_assert_held(&tb->lock);
+	ret = tb_x1_pcie_owner(tb);
+	if (ret)
+		return ret;
+	tcm = tb_priv(tb);
+	if (tb_x1_retained_mode(tb) || tcm->x1_idle_frozen || tcm->x1_hold_attempted ||
+	    tcm->x1_pcie_attempted || tcm->x1_cm_retire_attempted)
+		return -EALREADY;
+	if (!tb_x1_root_empty(tb) || !list_empty(&tcm->tunnel_list) ||
+	    atomic_read(&tcm->x1_pending_events))
+		return -EBUSY;
+	tcm->x1_idle_frozen = true;
+	smp_store_release(&tcm->x1_retained, true);
+	tcm->hotplug_active = false;
+	return 0;
+}
+
+static int tb_x1_idle_cm_check(struct tb *tb)
+{
+	struct tb_cm *tcm = tb_priv(tb);
+	struct tb_port *port;
+	unsigned int i;
+
+	lockdep_assert_held(&tb->lock);
+	if (tb->cm_ops != &tb_cm_ops || !tb->nhi || !tb->nhi->going_away ||
+	    tb->security_level != TB_SECURITY_NOPCIE ||
+	    !tb_ctl_x1_retired(tb->ctl, tb->nhi) || !tb_x1_retained_mode(tb) ||
+	    !tcm->x1_idle_frozen || tcm->hotplug_active || tcm->x1_hold_attempted ||
+	    tcm->x1_pcie_attempted || tcm->x1_cm_retired || !list_empty(&tcm->tunnel_list))
+		return -EPERM;
+	if (!tb_x1_root_empty(tb))
+		return -EBUSY;
+	for (i = 0; i < ARRAY_SIZE(tcm->groups); i++)
+		if (!list_empty(&tcm->groups[i].ports))
+			return -EBUSY;
+	list_for_each_entry(port, &tcm->dp_resources, list)
+		if (port->sw != tb->root_switch)
+			return -EXDEV;
+	return 0;
+}
+
+/**
+ * tb_x1_idle_retire_cm() - Remove the frozen, powered-off root of an idle domain
+ * @tb: Domain frozen by tb_x1_idle_freeze(), control channel already retired
+ * @s: Kernel-owned receipt
+ * @check_stopped: Frontend proof that the router is powered off
+ * @context: Argument for @check_stopped
+ *
+ * Omarchy flavor counterpart of tb_x1_retire_cm() for a domain that never had
+ * a device or tunnel. No control request or register access is issued.
+ */
+int tb_x1_idle_retire_cm(struct tb *tb, struct tb_x1_cm_retire *s,
+			 int (*check_stopped)(void *), void *context)
+{
+	struct tb_switch *root;
+	struct tb_cm *tcm;
+	unsigned int i;
+	int ret;
+
+	if (!tb || !s || !check_stopped)
+		return -EINVAL;
+	if (tb->cm_ops != &tb_cm_ops)
+		return -EPERM;
+	mutex_lock(&tb->lock);
+	tcm = tb_priv(tb);
+	if (tcm->x1_cm_retire_attempted || s->attempted) {
+		ret = -EALREADY;
+		goto unlock;
+	}
+	if (s->workers_drained || s->tunnel_released || s->routers_removed ||
+	    s->finished || s->error || s->stage) {
+		ret = -EINVAL;
+		goto unlock;
+	}
+	ret = check_stopped(context);
+	if (!ret)
+		ret = tb_x1_idle_cm_check(tb);
+	if (ret)
+		goto unlock;
+	tcm->x1_cm_retire_attempted = true;
+	s->attempted = true;
+	s->stage = "drain-cm-work";
+	mutex_unlock(&tb->lock);
+	cancel_delayed_work_sync(&tcm->remove_work);
+	for (i = 0; i < ARRAY_SIZE(tcm->groups); i++)
+		cancel_delayed_work_sync(&tcm->groups[i].release_work);
+	flush_workqueue(tb->wq);
+	mutex_lock(&tb->lock);
+	s->workers_drained = true;
+	ret = check_stopped(context);
+	if (!ret)
+		ret = tb_x1_idle_cm_check(tb);
+	if (!ret && atomic_read(&tcm->x1_pending_events))
+		ret = -EBUSY;
+	if (ret)
+		goto fail;
+	s->tunnel_released = true; /* Nothing was ever tunneled. */
+	root = tb_switch_get(tb->root_switch);
+	tb_remove_dp_resources(root);
+	tb->root_switch = NULL;
+	root->is_unplugged = true;
+	s->stage = "remove-powered-off-root";
+	mutex_unlock(&tb->lock);
+	tb_switch_remove_x1_powered_off(root);
+	mutex_lock(&tb->lock);
+	if (device_is_registered(&root->dev)) {
+		ret = -EBUSY;
+		goto fail;
+	}
+	s->routers_removed = true;
+	tcm->x1_cm_retired = true;
+	s->finished = true;
+	s->stage = "cm-retired-domain-retained";
+	mutex_unlock(&tb->lock);
+	tb_switch_put(root);
+	return 0;
+fail:
+	s->error = ret;
+unlock:
+	mutex_unlock(&tb->lock);
+	return ret;
+}
