diff --git a/drivers/thunderbolt/qcom-usb4-x1-host.c b/drivers/thunderbolt/qcom-usb4-x1-host.c
index 7fe5423..771c350 100644
--- a/drivers/thunderbolt/qcom-usb4-x1-host.c
+++ b/drivers/thunderbolt/qcom-usb4-x1-host.c
@@ -237,6 +237,10 @@ struct x1_host {
 	bool domain_unregistered;
 	bool domain_retired;
 	int domain_retire_error;
+	/* Omarchy flavor: power-down of a prepared router that never connected. */
