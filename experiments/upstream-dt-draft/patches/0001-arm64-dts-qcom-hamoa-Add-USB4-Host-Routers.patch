From ba5a4c1a01cee89be9c2418bbcbe4381d3c32285 Mon Sep 17 00:00:00 2001
From: Birk Skyum <birk.skyum@pm.me>
Date: Wed, 23 Sep 2026 13:48:23 +0200
Subject: [PATCH 1/2] arm64: dts: qcom: hamoa: Add USB4 Host Routers

Describe the three USB4 Host Routers of the X1E family, following the
qcom,usb4-hr binding as posted in the RFC. Each router drives its port's
QMP PHY in USB4 mode and uses that port's sideband pins.

The interrupt pairs come from the UBF0.PRT0-2 resources in the Lenovo
Yoga Slim 7x DSDT; router 0 matches the binding example. All three
routers are disabled here, boards enable them and link each one to its
Type-C mux chain.
---
 arch/arm64/boot/dts/qcom/hamoa.dtsi | 420 ++++++++++++++++++++++++++++
 1 file changed, 420 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/hamoa.dtsi b/arch/arm64/boot/dts/qcom/hamoa.dtsi
index 4e35254cd..129bd0b7c 100644
--- a/arch/arm64/boot/dts/qcom/hamoa.dtsi
+++ b/arch/arm64/boot/dts/qcom/hamoa.dtsi
@@ -6802,6 +6802,69 @@
 					bias-pull-up;
 				};
 			};
+
+			usb4_0_sb_default: usb4-0-sb-default-state {
+				rx-pins {
+					pins = "gpio163";
+					function = "usb0_sbrx";
+					bias-disable;
+				};
+
+				txa-pins {
+					pins = "gpio164";
+					function = "usb0_sbtx";
+					drive-strength = <10>;
+					bias-pull-up;
+				};
+
+				txb-pins {
+					pins = "gpio165";
+					function = "usb0_sbtx";
+					drive-strength = <10>;
+				};
+			};
+
+			usb4_1_sb_default: usb4-1-sb-default-state {
+				rx-pins {
+					pins = "gpio172";
+					function = "usb1_sbrx";
+					bias-disable;
+				};
