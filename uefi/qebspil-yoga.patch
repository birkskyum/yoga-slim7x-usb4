+static EFI_STATUS yoga_check_reserved(const struct pil_fw *fw)
+{
+	UINTN count, key, stride;
+	UINT32 version;
+	EFI_MEMORY_DESCRIPTOR *map;
+	UINT64 pos = fw->mem_addr, end = pos + fw->mem_size;
+	EFI_STATUS status = EFI_SECURITY_VIOLATION;
+
+	map = LibMemoryMap(&count, &key, &stride, &version);
+	if (!map)
+		return EFI_OUT_OF_RESOURCES;
+	if (stride < sizeof(*map) || version != EFI_MEMORY_DESCRIPTOR_VERSION)
+		goto out;
+	/* EFI map need not be sorted. Cover the entire target with reserved
+	 * descriptors; never copy firmware into allocatable or MMIO memory.
+	 */
+	while (pos < end) {
+		BOOLEAN found = FALSE;
+		for (UINTN i = 0; i < count; i++) {
+			EFI_MEMORY_DESCRIPTOR *d = (VOID*)((UINT8*)map + i * stride);
+			UINT64 limit;
+			if (d->NumberOfPages > (~(UINT64)0 - d->PhysicalStart) / EFI_PAGE_SIZE)
+				goto out;
+			limit = d->PhysicalStart + d->NumberOfPages * EFI_PAGE_SIZE;
+			if (d->PhysicalStart > pos || limit <= pos)
+				continue;
+			if (d->Type != EfiReservedMemoryType)
+				goto out;
+			pos = limit < end ? limit : end;
+			found = TRUE;
+			break;
+		}
+		if (!found)
+			goto out;
+	}
+	status = EFI_SUCCESS;
+out:
+	FreePool(map);
+	return status;
+}
